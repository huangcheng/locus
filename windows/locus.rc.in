// Windows resources: app icon + version info. This is a configure_file
// template — CMake substitutes the version from project(); the generated
// locus.rc lands in the build dir. Never edit that copy.
#include <winres.h>

IDI_ICON1 ICON DISCARDABLE "@CMAKE_CURRENT_SOURCE_DIR@/windows/locus.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @LOCUS_VERSION_COMMA@
 PRODUCTVERSION @LOCUS_VERSION_COMMA@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"  // en-US, Unicode
        BEGIN
            VALUE "CompanyName", "HUANG Cheng"
            VALUE "FileDescription", "Locus quick-launch overlay"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "Locus"
            VALUE "LegalCopyright", "Copyright (c) 2026 HUANG Cheng"
            VALUE "OriginalFilename", "locus.exe"
            VALUE "ProductName", "Locus"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
